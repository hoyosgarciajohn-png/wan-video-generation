{
  "name": "wan-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:validator",
    "pretest": "npm run generate:validator",
    "pretest:ui": "npm run generate:validator",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate:validator && tsc --noEmit && vite build",
    "generate:validator": "node scripts/generate-validator.mjs",
    "test": "node --import tsx --test tests/model.test.ts tests/api.test.ts tests/validator-csp.test.mjs",
    "test:browser": "playwright test",
    "types": "python scripts/generate_types.py && prettier --write src/contract.ts",
    "format:check": "prettier --check src tests vite.config.ts playwright.config.ts",
    "test:ui": "node --import tsx --import ./tests/dom-setup.ts --test tests/ui.test.tsx tests/connected.test.tsx"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  }
}
