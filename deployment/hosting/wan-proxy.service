[Unit]
Description=WAN HTTPS proxy
After=network-online.target wan-controller.service
Wants=network-online.target

[Service]
User=wan
Group=wan
Environment=XDG_DATA_HOME=/var/lib/wan/caddy
Environment=XDG_CONFIG_HOME=/var/lib/wan/caddy-config
ExecStart=/usr/bin/caddy run --config /etc/wan/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/wan/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wan
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
